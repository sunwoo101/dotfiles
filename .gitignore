# files generated by scripts/render_configs.sh from colors.json + override.
# regenerated on every accent click via the quickshell apply chain — tracking
# them just creates noisy diffs. they're rebuilt on every install run.
.config/colors.conf
.config/bashrc/colors
.config/gtk-3.0/gtk.css
.config/gtk-3.0/settings.ini
.config/gtk-4.0/gtk.css
.config/gtk-4.0/settings.ini
.config/ohmyposh/theme.omp.json
.config/hypr/conf/colors.conf
home/.gtkrc-2.0
sddm-theme/dotfiles/theme.conf

# user/machine state, not configuration. rewritten by applications or
# containing absolute $HOME paths, so tracking them produces diffs nobody
# authored and values that don't port to another machine.
.config/mimeapps.list
.config/gtk-3.0/bookmarks
.config/systemd/user/tiaga-link.service
.config/systemd/user/default.target.wants/tiaga-link.service
